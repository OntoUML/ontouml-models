:I_nBAPaGAqAAagm4 a ontouml:Class ;
    ontouml:description "“Aristotle’s search for the good is a search for the highest good [goal], and he assumes that the highest good, whatever it turns out to be, has three characteristics: it is desirable for itself, it is not desirable for the sake of some other good, and all other goods are desirable for its sake.” (Kraut)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "HighestGoal"@en ;
