:ahFTUraGAqAAZwtH a ontouml:Class ;
    ontouml:description "\"When a change, or a state of rest, is not natural [is Forced Motion], both the active and the passive potentiality need to be specified… The presence of the potentiality… can happen in the face of a contrary disposition on the part of the nature of the entity—in which case the change is forced (biâi) or contrary to nature (para phusin).” (Bodnar)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "ForcedMotion"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
