:5qQf75aGAqAAaw4m a ontouml:Class ;
    ontouml:attribute :9hb8VFaAUcEwZgof,
        :Fy58VFaAUcEwZgod,
        :kqY8VFaAUcEwZgiG ;
    ontouml:description """Aristotelian sciences divide into three: (i) theoretical, (ii) practical, and (iii) productive. The principles of division are straightforward: theoretical science seeks knowledge for its own sake; practical science concerns conduct and goodness in action, both individual and societal; and productive science aims at the creation of beautiful or useful objects …. 
Science or knowledge (epistemê) is about universal, necessary things with identified causes. Logic in this sense is not a science, it is “just” a tool. (Shields)""" ;
    ontouml:isAbstract true ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Science-Knowledge"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :8evc5z6GAqACBh.w ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:category .

