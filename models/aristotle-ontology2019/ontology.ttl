    ontouml:isViewOf :54PrSbaGAqAAaQnf ;
    ontouml:project :8evc5z6GAqACBh.w ;
    ontouml:shape :54PrSbaGAqAAaQne_shape .

:5RMfoPaGAqAAagyN a ontouml:ClassView ;
    ontouml:isViewOf <https://w3id.org/ontouml-models/model/aristotle-ontology2019#PJKhAPaGAqAAagn.> ;
