:FiU0VFaAUcEwZgci a ontouml:Class ;
    ontouml:description "A syllogism is an “inference with two premises, each of which is a categorical sentence, having exactly one term in common, and having as a conclusion a categorical sentence the terms of which are just those two terms not shared by the premises”. (Smith) Not all the triplets of two premises and one conclusion of the required structure are syllogisms, only just those who lead to a valid inference, listed in the moods. E.g. P1: All man are mortal. P2: Socrates is man, C: Socrates is mortal." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "Syllogism"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :8evc5z6GAqACBh.w ;
    ontouml:restrictedTo ontouml:relatorNature ;
    ontouml:stereotype ontouml:relator .

