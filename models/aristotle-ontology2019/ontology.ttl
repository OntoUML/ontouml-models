    ontouml:stereotype ontouml:subkind .

:lYJPSbaGAqAAaQqW a ontouml:Class ;
    ontouml:description "\"The existence of the city-state also requires an efficient cause, namely, its ruler (archôn). On Aristotle’s view, a community of any sort can possess order only if it has a ruling element or authority.” (Miller)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
