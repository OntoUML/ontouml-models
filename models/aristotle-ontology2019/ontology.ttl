:kYBVNFaGAqAAaQjT a ontouml:Class ;
    ontouml:attribute :eeZYPFaGAqAAaR43 ;
    ontouml:description "Subjects and predicates of assertions are terms (horos) which can be either individual, e.g. Socrates, or universal, e.g. human. Subjects may be individual or universal, but predicates can only be universals." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
