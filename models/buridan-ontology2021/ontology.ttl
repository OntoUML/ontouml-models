    ontouml:shape :tc_fTD6GAqACBgoh_shape .

:vjEMf96GAqAAaipv a ontouml:Class ;
    ontouml:description "“Improper supposition […] is the kind of supposition or reference a term has when it is used figuratively and not literally. Now a detailed semantics of metaphor was just as much beyond the reach of mediaeval authors as it is beyond our reach today. So we should not be surprised to find that the theory of improper supposition is not worked out very fully.” (Spade)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "ImproperSupposition"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :3elogL6GAqAAaRaG ;
    ontouml:restrictedTo ontouml:relatorNature ;
    ontouml:stereotype ontouml:subkind .

