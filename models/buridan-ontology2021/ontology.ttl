:ludTv16GAqAAZieG a ontouml:Class ;
    ontouml:description "“Buridan also draws the famous distinction between logica utens and logica docens, that is, logic-in-use and logical doctrine, only the latter of which can be called an art or practical science, whereas the former embodies those operative principles that are spelled out by the latter. For of course logical rules are operative in all our rational activities, yet those rules in operation, without being spelled out and reflected on, do not constitute logical knowledge. In fact, as Buridan remarks, sometimes, as in the case of sophistic arguments, they lead to something contrary to knowledge, namely, deception.\" (Klima)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "Logic-in-use"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :3elogL6GAqAAaRaG ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:kind .

:oHGNsN6GAqAAaS.Y a ontouml:ClassView ;
    ontouml:isViewOf :oHGNsN6GAqAAaS.Z ;
    ontouml:project :3elogL6GAqAAaRaG ;
    ontouml:shape :oHGNsN6GAqAAaS.Y_shape .

:pKiNsN6GAqAAaS90 a ontouml:Class ;
    ontouml:description "Context is the “variable conditions of interpretation, such as when, where, by whom, to whom, according to what intention, and so on a token is to be interpreted […] So, in the specification of acts of imposition we might use variables indistinctly referring to any number of individual users, various times, places, or any other relevant contextual factors […]\" (Klima)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "Context"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :3elogL6GAqAAaRaG ;
    ontouml:restrictedTo ontouml:intrinsicModeNature ;
    ontouml:stereotype ontouml:mode .

