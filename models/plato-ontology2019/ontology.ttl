:8c2aQnaD.AAAAQ7E a ontouml:Class ;
    ontouml:description "The noble lie is part of education and promotes the universal acceptance of the individual's class status. It states, that Guardians have gold, Auxiliaries have silver, and Producers bronze in their blood, thus the members of these classes can not mate." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "NobleLie"@en ;
