    ontouml:shape :z.nkQnaD.AAAAQtt_shape .

:DINuIHaGAqAAbAvV a ontouml:Class ;
    ontouml:description "\"there are in fact five kinds of pure psychological constitutions: aristocratically [...], timocratically [...], oligarchically [...], democratically [...], and tyrannically constituted persons... The first three of these constitutions are characteristically ordered toward simple aims (wisdom, honor, and money, respectively), but the last two are not so ordered, because there is no simple aim of the unnecessary appetites, be they lawful or lawless.\" (Brown)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "PsychologicalConstitution"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :rV59Ez6GAqAAawsy ;
    ontouml:restrictedTo ontouml:intrinsicModeNature ;
    ontouml:stereotype ontouml:mode .

:PB.EQnaD.AAAAQpo a ontouml:Class ;
    ontouml:description "The Ideal City, (Kallipolis, beautiful city) “includes three classes, two that guard the city and its constitution (ruling and auxiliary guardians) and one that produces what the city needs.” (Brown)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "IdealCity"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :rV59Ez6GAqAAawsy ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:kind .

:W0O9L7aGAqAAbA3s a ontouml:Class ;
    ontouml:description "“The world’s body is composed of fire (for visibility) and earth (for tangibility), but these so-called elements require the mediation of air and water in a progression of proportion to bind them together into a unified, concordant whole.” (Zeyl,Sattler)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "Element"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :rV59Ez6GAqAAawsy ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:kind .

