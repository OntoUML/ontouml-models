:epd1n96GAqAAaSrV a ontouml:Class ;
    ontouml:description "\"Being, then, is a primitive ontological relation designed exclusively to capture the special tie between that which possesses an essence and the essence possessed.\" (Silverman)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "Being"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
