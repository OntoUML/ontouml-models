:51BOY7aGAqAAagxd a ontouml:Class ;
    ontouml:description "Universe “is a living thing (zô[i]on, also translatable as ‘animal’), because it is better for it to possess intelligence than to lack it, and the acquisition of intelligence by anything requires the acquisition of soul. It is complete, and thus it includes within itself all the species of living things as its parts. It is unique, because its model is unique; the uniqueness of the model follows from its completeness.” (Zeyl,Sattler)" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Universe"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :rV59Ez6GAqAAawsy ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:subkind .

