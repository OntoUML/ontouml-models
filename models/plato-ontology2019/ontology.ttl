    ontouml:restrictedTo ontouml:relatorNature ;
    ontouml:stereotype ontouml:relator .

:jgo4tbaGAqAAagig a ontouml:Class ;
    ontouml:description "“The universe exists and manifests goodness because it is the handiwork of a supremely good, ungrudging Craftsman [Demiurge], who brought order to an initially disorderly state of affairs… the Craftsman seems to be an anthropomorphic representation of Intellect.” (Zeyl,Sattler) The Demiurge looks to the Form when creates the Universe" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "Demiurge"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :rV59Ez6GAqAAawsy ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:kind .

