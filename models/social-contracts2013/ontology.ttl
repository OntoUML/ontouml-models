:icYAPOGFS_j2pL7V a ontouml:Class ;
    ontouml:description """A criação do Estado foi feita pela sociedade natural, composta de indivíduos que detinham liberdade e o poder da vingança privada.

Ao criarem o Estado, uma porção dessa sociedade - os governados - deram a uma outra porção dessa sociedade - os governantes - o poder supremo que é evidenciado pelo monopólio da força com o uso da coerção irresistível interna""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "Estado"@pt-br ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :HHoAPOGFS_j2pLrw ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:kind .

