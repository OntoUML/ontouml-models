:EEXQ7WGGAqCGoAlv a ontouml:Class ;
    ontouml:description "An item of interest within the enterprise that is the subject of an enterprise architecture model, whereby “item” can be anything from ideas and objects to processes and information, or aggregations thereof. " ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "System"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :oFBubWGGAqCGoABO ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:kind .

