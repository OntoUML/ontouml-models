:cqxgPOGFS_j2pDNb a ontouml:Class ;
    ontouml:description """É definida como um conjunto de equipamentos, por 2 plataformas assentes ao pavimento que, quando comprimidas pelo pneumáticos, tracionam as respectivas células de carga, gerando impulsos elétricos, permitindo a visualização das pesagens através do classificador (indicador digital), registrando-as, em paralelo, numa impressora automática. Essas operações têm mostrado a imprescindibilidade da existência desses equipamentos, pois enquanto a média do excesso na balança na balança estática eletrônicas é de 600 Kg, nas móveis esse valor salta para 2000 Kg.

Fonte: Rodovias Reguladas pela ANTT - Relatório Anual. 2009.""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Balança Móvel"@pt-br ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :g3.gPOGFS_j2pB.E ;
