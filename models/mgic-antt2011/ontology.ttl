:aqxgPOGFS_j2pDNc a ontouml:Class ;
    ontouml:description """mantendo se as antigas plataformas de passagem, introduziu-se uma célula de carga no conjunto possibilitando a transformação dos esforços mecânicos em impulsos elétricos, resultado num sistema mais perfeito de controle, cujo ‘‘software’’ permite os registros automáticos após o comando, pelo operador, de códigos correlatos ao tipo de veículos a ser fiscalizado. Paralelamente, acoplado ao classificador de veículos, foram desenvolvidas impressoras automáticas a de tíquete, acionada quando configurado excesso de carga nas diversas modalidades, a de registro de passagem, mostrando todos os detalhes possíveis de cada veiculo pesado.

Fonte: Rodovias Reguladas pela ANTT - Relatório Anual. 2009.""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Balança Fixa Estática"@pt-br ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :g3.gPOGFS_j2pB.E ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:subkind .

