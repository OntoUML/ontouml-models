<https://w3id.org/ontouml-models/model/b60d005c-b9a6-52b4-888d-db304a117625/> a dcat:Dataset, mod:SemanticArtefact, dcat:Resource;
    dct:isPartOf <https://w3id.org/ontouml-models/catalog/b663ca18-8085-44a7-bcfe-2c2b5ba1faa8>;
    dct:title "Wargame Ontology";
    dct:issued "2025"^^xsd:gYear;
    dct:modified "2025"^^xsd:gYear;
    dcat:theme lcc:U;
    skos:editorialNote "The submitted model comprises ontologies for wargame design characteristics, wargame elements, and the specification and design phases of the wargame design process. The models are intended as a reference for wargame design and development and as a foundation for interoperability between wargames; planning, execution, and analysis phases remain outside the current scope.";
    dct:language "en";
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    dct:contributor <https://orcid.org/0000-0002-0043-3098>,
