:4Pxn3HGGAqAAahWq a ontouml:Class ;
    ontouml:attribute :oAXyVfGGAqAAqS8J ;
    ontouml:description """An Enterprise is an organization and a market participant. 
Enterprises claim economic resources (assets) against other parties and face claims from other parties (liabilities and equity claims). 
They also exhibit a commitment toward owners and are enabled to use resources and claims in economic exchanges and other activities designed to realize economic resources to gain economic benefits.""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype false ;
    ontouml:name "Enterprise"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :gLGH3HGGAqAAahF6 ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:kind .

