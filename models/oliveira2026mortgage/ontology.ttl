:8W3ZiZmD.AAAAQW0 a ontouml:Class ;
    ontouml:attribute :nSWliZmD.AAAAQXn,
        :oSaliZmD.AAAAQXl ;
    ontouml:description "In de context van Nederlandse hypotheken verwijst onderpand naar het specifieke registergoed, zoals een huis of appartement, dat dient als fysieke zekerheid voor een lening. Volgens het Nederlandse recht biedt de waarde van het onderpand de geldverstrekker de garantie dat de schuld kan worden verhaald; als de lener niet aan de betalingsverplichtingen voldoet, oefent de bank haar hypotheekrecht uit om dit eigendom te verkopen — vaak via een executieverkoop of veiling — om het openstaande saldo te vereffenen. Omdat de lening wordt gedekt door dit tastbare bezit, is het risico voor de bank lager, wat doorgaans resulteert in gunstigere rentetarieven voor de lener in vergelijking met leningen zonder onderpand." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Onderpand"@nl ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :eAFZiZmD.AAAAQBO ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:roleMixin .

