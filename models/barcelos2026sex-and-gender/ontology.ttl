:JcwZSzmGAqAEHBtu a ontouml:Class ;
    ontouml:description """A Self-identified Two-gender Person is a person whose self-identification is characterized by one self-identified male gender and one self-identified female gender, rather than by a self-identified non-binary gender.

This description clarifies that the class concerns a specific form of non-binary self-classification grounded in the joint presence of male and female self-identification. It helps distinguish this case from other non-binary self-classifications that are not characterized in this way.""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Self-identified Two-gender Person"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:phase .

:JjsR_9mGAqAEHBnA a ontouml:Class ;
    ontouml:description "A gender attributor is an individual agent who participates as the attributor in one or more gender attributions directed at an externally gender-attributed person. The attributor is the source participant of the attribution and, in each attribution, is distinct from the person to whom the attribution is directed." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Gender Attributor"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:roleMixin .

