:w7lkwjmGAqAEHDIn a ontouml:Class ;
    ontouml:description """Gender Context captures the context in which a gender outcome is established, recorded, or attributed.

It supports distinguishing contexts such as self-identified gender, externally-attributed gender, administrative gender, legal gender, and gender expression, while keeping the context separate from the resulting gender outcome category.""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isPowertype true ;
    ontouml:name "Gender Context"@en ;
    ontouml:order "2"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:typeNature ;
    ontouml:stereotype ontouml:type .

:wNduRemGAqAEHBDW a ontouml:Class ;
    ontouml:description """This definition characterizes the absence of a recognized legal gender assignment for a person within formal records.

Legally Unassigned Gender Person denotes a person for whom no legal gender is recorded as recognized in the relevant legal record or context. This role distinguishes persons lacking a recognized legal gender assignment from those whose legal gender has been formally recognized.""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Legally Unassigned Gender Person"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:role .

