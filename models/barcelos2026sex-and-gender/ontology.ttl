:1B4KlDmGAqAEHDMg a ontouml:Class ;
    ontouml:description "Phenotypic Male Sex denotes the classification of a person's phenotypic sex as male based on observable anatomical and morphological features, as established through clinical or visual assessment. It provides a male classification tied to phenotypic observation, supporting a clear distinction from chromosome-based classification and from administrative recording at birth." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Phenotypic Male Sex"@en ;
