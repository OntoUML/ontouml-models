    ontouml:restrictedTo ontouml:extrinsicModeNature ;
    ontouml:stereotype ontouml:subkind .

:cEkguemGAqAEHA9K a ontouml:Class ;
    ontouml:description "Describes an individual assessed as having predominantly female-typical anatomical features. The classification reflects traits typically associated with female development." ;
