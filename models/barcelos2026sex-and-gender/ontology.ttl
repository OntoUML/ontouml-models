:t4GOsemAUygeIx3a a ontouml:Class ;
    ontouml:description "A Person with Regular Sex Chromosome is represented as an individual whose sex chromosomes conform to the most frequent configurations in the population. In the model this class specializes Person and is disjoint and complete with its variant counterpart, capturing the regular chromosomal patterns used to define standard karyotypical categories. Its role is to provide the structural basis for distinguishing the commonly occurring XX and XY arrangements (reflected in Regular Karyotypical Female Person and Regular Karyotypical Male Person) from other possibilities." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Person with Regular Sex Chromosome"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:subkind .

:tHVz_9mGAqAEHC6h a ontouml:Class ;
    ontouml:description "Self-identified Transgender Person is a self-aware person who self-identifies as transgender. It is mutually exclusive with Self-identified Cisgender Person and together they classify self-aware persons by self-identified gender modality, while allowing externally attributed transgender classifications to also apply to the same person." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Self-identified Transgender Person"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:phase .

:un2muemGAqAEHBOl a ontouml:Class ;
    ontouml:description "An umbrella category for traits that show differences between sexes. These characteristics are used to classify biological sex by examining their type and distribution in an individual. Examples include body hair patterns, skeletal structure, and other anatomical features." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Sexual Dimorphic Characteristic"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:category .

