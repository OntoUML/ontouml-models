:ewZBsemAUygeIyIr a ontouml:Diagram ;
    ontouml:containsView <https://w3id.org/ontouml-models/model/barcelos2026sex-and-gender#.mlBsemAUygeIyJY>,
        :0mlBsemAUygeIyJV,
