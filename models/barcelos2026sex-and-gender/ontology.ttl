:zj1W4emAUygeIwmI a ontouml:Diagram ;
    ontouml:containsView <https://w3id.org/ontouml-models/model/barcelos2026sex-and-gender#.bKfOemGAqAEHAyE>,
        :14WfOemGAqAEHAyp,
