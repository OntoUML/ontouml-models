:E19Kg.mGAqAEHBDn a ontouml:Class ;
    ontouml:description "This definition describes the person role tied to an administratively recognized gender assignment. Administratively Recognized Gender Person denotes a person who is the target of an administrative gender recognition act and thereby has an administrative gender acknowledged for administrative purposes. This role captures that the relevant administrative gender is established through an attribution or recognition act rather than solely through self-identification or gender expression." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Administratively Recognized Gender Person"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:role .

:GNvioDmGAqAEHBt7 a ontouml:Class ;
    ontouml:description "Self-identified Female Gender is a female gender held by a self-aware person through self-identification. It characterizes the person as female from the person's own perspective and may coexist with female gender attributions made by external parties or through administrative or legal assignment." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Self-identified Female Gender"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:intrinsicModeNature ;
    ontouml:stereotype ontouml:phase .

:KIdusemAUygeIx74 a ontouml:Class ;
    ontouml:description """A person whose karyotypical sex is female, determined by the sex chromosome complement. This class classifies persons by karyotype only and does not depend on phenotypic traits or on any sex assigned or assessed at birth or later.

Karyotypic Female-sex Person subsumes both Regular Karyotypical Female Person and Variant Karyotypical Female Person, which are categorized as female in the model. It is exclusive with Karyotypic Male-sex Person within the karyotypical-sex classification of persons.""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Karyotypic Female-sex Person"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:subkind .

:QJyguemGAqAEHA.V a ontouml:Class ;
    ontouml:description "Includes individuals whose anatomical traits do not clearly align with either male-typical or female-typical categories. This classification acknowledges the existence of anatomical diversity and variations outside binary expectations." ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Phenotypic Ambiguous-sex Person"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:functionalComplexNature ;
    ontouml:stereotype ontouml:role .

:SmVHwDmGAqAEHBYZ a ontouml:Class ;
    ontouml:description """Female Sex at Birth is a sex-at-birth classification that is recorded as female during birth registration. It represents an officially documented category used in administrative and legal records.

This classification concerns what is formally recorded at birth, rather than making a claim about a person's later gender classification or gender expression.""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Sex-at-birth Female Sex"@en ;
    ontouml:order "1"^^xsd:nonNegativeInteger ;
    ontouml:project :qmUW4emAUygeIwWe ;
    ontouml:restrictedTo ontouml:extrinsicModeNature ;
    ontouml:stereotype ontouml:subkind .

:XANHwDmGAqAEHBYq a ontouml:Class ;
    ontouml:description """Indeterminate Sex at Birth is a Sex at Birth classification that is formally recorded as indeterminate at the time of birth. It covers cases where the birth record does not assign a male or female sex-at-birth category.

This classification reflects the outcome of formal documentation at birth and does not, by itself, determine later gender classification or gender expression.""" ;
    ontouml:isAbstract false ;
    ontouml:isDerived false ;
    ontouml:isExtensional false ;
    ontouml:isPowertype false ;
    ontouml:name "Sex-at-birth Indeterminate Sex"@en ;
