:pXbUtDmAUygefhuJ a ontouml:Diagram ;
    ontouml:containsView <https://w3id.org/ontouml-models/model/barcelos2026sex-and-gender#.ZActDmAUygefiRj>,
        :01u9tDmAUygefhqP,
        :0T_stDmAUygefiRT,
        :0kH2tDmAUygefhZW,
        :50u9tDmAUygefhqF,
        :5go0tDmAUygefh5Q,
        :C2wctDmAUygefiSO,
        <https://w3id.org/ontouml-models/model/barcelos2026sex-and-gender#Mgo0tDmAUygefh4.>,
        :UT_stDmAUygefiRR,
        :WQo0tDmAUygefh56,
        :eZActDmAUygefiRh,
