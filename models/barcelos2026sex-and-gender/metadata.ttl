<https://w3id.org/ontouml-models/model/9963e2a3-ae9d-56ca-990b-80bb4279a57d/> a dcat:Dataset, mod:SemanticArtefact, dcat:Resource;
    dct:isPartOf <https://w3id.org/ontouml-models/catalog/b663ca18-8085-44a7-bcfe-2c2b5ba1faa8>;
    dct:title "Health-RI Semantic Interoperability Initiative's Sex and Gender Model";
    dct:issued "2026"^^xsd:gYear;
    dcat:theme lcc:R;
    skos:editorialNote "This Catalog entry contains the Sex and Gender extract from the larger Health-RI Ontology, together with supporting classes retained for structural coherence. Its scope covers sex axes and outcomes; gender contexts, outcomes, and modalities; and the shared sex-gender outcome layer. Other Health-RI Ontology subject areas are outside this entry.";
    dct:language "en";
    dcat:landingPage <https://w3id.org/health-ri/semantic-interoperability>;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    dct:contributor <https://dblp.org/pid/96/8280>,
                    <https://orcid.org/0000-0003-0771-3516>,
                    <https://orcid.org/0009-0006-1783-9082>,
                    <https://orcid.org/0009-0002-3089-9558>,
                    <https://orcid.org/0000-0002-7944-2594>,
                    <https://orcid.org/0000-0003-4715-9070>,
                    <https://orcid.org/0009-0000-0967-7294>,
                    <https://orcid.org/0000-0001-8802-7002>;
    dcat:keyword "sex"@en,
                 "gender"@en,
                 "sex at birth"@en,
                 "phenotypic sex"@en,
                 "karyotypic sex"@en,
                 "gender context"@en,
                 "gender modality"@en;
    dct:source <https://doi.org/10.5281/zenodo.20219613>;
